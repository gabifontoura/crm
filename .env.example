# Copy to .env.local for local development, and add the same variables in
# Vercel > Project > Settings > Environment Variables.
# Without them the API stores data in local JSON files under .data/.

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret. Never prefix it with VITE_ (that would ship it to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: folder for the local JSON storage (defaults to ./.data)
# DATA_DIR=.data

# Optional: real email (status emails, automatic billing emails) through Resend.
# Without these the emails are only recorded on the CRM, marked "simulated".
RESEND_API_KEY=
EMAIL_FROM="CRM <no-reply@your-domain.com>"
# Link used in emails, e.g. https://your-app.vercel.app
APP_URL=

# Optional: real SMS / WhatsApp for automatic billing messages, through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Optional: protects the daily cron that sends automatic billing messages (Vercel sets it as a Bearer token).
CRON_SECRET=

# Public demo: a notice on every screen, limits on what visitors create, and a
# daily reset back to the demo data (03:00 UTC, from vercel.json). Leave it off
# for a real database.
DEMO_MODE=
